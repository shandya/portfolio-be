{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "Express API for the portfolio site",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node --project tsconfig.scripts.json scripts/seed.ts",
    "test": "vitest run",
    "migrate": "ts-node --project tsconfig.scripts.json scripts/migrate.ts",
    "check:load": "node scripts/check-load.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/node": "^3.2.14",
    "body-parser": "^1.20.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "sanitize-html": "2.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
